# Hardened Caddyfile for FrankenPHP (HIP HRIS API)
{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}

	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	# Block execution and access to PHP or other script extensions inside storage directories
	@storageScripts {
		path_regexp storage_script (?i)^/(?:public/)?storage/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp|exe)$
	}

	# Block script paths under /public/storage/*
	handle /public/storage/* {
		respond @storageScripts "Forbidden" 403
		respond 404
	}

	# Serve files under /storage/* strictly as static files (never passed to php_server)
	handle /storage/* {
		respond @storageScripts "Forbidden" 403
		header X-Content-Type-Options "nosniff"
		file_server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		#worker /path/to/your/worker.php
	}
}

import Caddyfile.d/*.caddyfile
